---
layout: null
---
{% assign home_prefix = '' %}
{% assign page_label = 'Academic Homepage' %}
{% if page.homepage_cv %}
  {% assign home_prefix = '/' | relative_url %}
  {% assign page_label = 'Curriculum Vitae' %}
{% endif %}
{% assign asset_version = site.time | date: '%s' %}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta
      name="description"
      content="Deokhyun Ahn researches reliable and efficient video understanding for social good, with a focus on anomaly detection and faithful vision-language systems."
    >
    <meta property="og:title" content="Deokhyun Ahn | {{ page_label }}">
    <meta
      property="og:description"
      content="Reliable and efficient video understanding for social good. Research in video anomaly detection, contextual dynamics, and faithful vision-language systems."
    >
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ page.url | absolute_url }}">
    <title>
      Deokhyun Ahn |
      {{ page_label }}
    </title>
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22><rect width=%2264%22 height=%2264%22 rx=%2212%22 fill=%22%231565c0%22/><text x=%2232%22 y=%2239%22 text-anchor=%22middle%22 font-family=%22Arial%22 font-size=%2222%22 font-weight=%22700%22 fill=%22white%22>DA</text></svg>"
    >
    <link rel="stylesheet" href="{{ '/assets/css/homepage.css' | relative_url }}?v={{ asset_version }}">
    {% if page.homepage_cv %}
      <link rel="stylesheet" href="{{ '/assets/css/homepage-cv.css' | relative_url }}?v={{ asset_version }}">
    {% endif %}
    <script src="{{ '/assets/js/homepage.js' | relative_url }}?v={{ asset_version }}" defer></script>
  </head>
  <body data-home-url="{{ '/' | relative_url }}">
    <svg class="svg-sprite" aria-hidden="true">
      <symbol id="icon-menu" viewBox="0 0 24 24">
        <path d="M4 6h16M4 12h16M4 18h16" />
      </symbol>
      <symbol id="icon-search" viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="7" />
        <path d="m20 20-4-4" />
      </symbol>
      <symbol id="icon-moon" viewBox="0 0 24 24">
        <path d="M20.5 15.2A8.5 8.5 0 0 1 8.8 3.5 8.5 8.5 0 1 0 20.5 15.2Z" />
      </symbol>
      <symbol id="icon-sun" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="4" />
        <path
          d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
        />
      </symbol>
      <symbol id="icon-monitor" viewBox="0 0 24 24">
        <rect x="3" y="4" width="18" height="13" rx="2" />
        <path d="M8 21h8M12 17v4" />
      </symbol>
      <symbol id="icon-close" viewBox="0 0 24 24">
        <path d="m6 6 12 12M18 6 6 18" />
      </symbol>
      <symbol id="icon-mail" viewBox="0 0 24 24">
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m4 7 8 6 8-6" />
      </symbol>
      <symbol id="icon-linkedin" viewBox="0 0 24 24">
        <rect x="3" y="3" width="18" height="18" rx="2" />
        <path d="M7 10v7M7 7v.01M11 17v-7M11 13a3 3 0 0 1 6 0v4" />
      </symbol>
      <symbol id="icon-scholar" viewBox="0 0 24 24">
        <path d="m2 9 10-5 10 5-10 5L2 9Z" />
        <path d="M6 11v5c3 2.4 9 2.4 12 0v-5M22 9v6" />
      </symbol>
      <symbol id="icon-file" viewBox="0 0 24 24">
        <path d="M6 2h8l4 4v16H6zM14 2v5h5" />
        <path d="M9 13h6M9 17h6" />
      </symbol>
      <symbol id="icon-github" viewBox="0 0 24 24">
        <path
          d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.88c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.6 9.6 0 0 1 12 6.82a9.6 9.6 0 0 1 2.5.34c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.86v2.76c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"
        />
      </symbol>
    </svg>

    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="nav-shell">
        <button
          class="menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="site-nav"
          aria-label="Toggle navigation"
        >
          <svg aria-hidden="true">
            <use href="#icon-menu"></use>
          </svg>
        </button>

        <a class="wordmark" href="{{ home_prefix }}#about">Deokhyun Ahn</a>

        <nav id="site-nav" class="site-nav" aria-label="Primary navigation">
          <a
            {% unless page.homepage_cv %}
              class="is-active"
            {% endunless %}
            href="{{ home_prefix }}#about"
            >Home</a
          >
          <a href="{{ home_prefix }}#research">Featured</a>
          <a href="{{ home_prefix }}#publications">Publications</a>
          <a href="{{ home_prefix }}#experience">Experience</a>
          <a href="{{ home_prefix }}#contact">Contact</a>
        </nav>

        <div class="nav-tools">
          <button
            class="icon-button search-toggle"
            type="button"
            aria-label="Search"
          >
            <svg aria-hidden="true">
              <use href="#icon-search"></use>
            </svg>
          </button>
          <div class="theme-picker">
            <button
              class="icon-button theme-toggle"
              type="button"
              aria-label="Choose color theme"
              aria-expanded="false"
            >
              <svg aria-hidden="true">
                <use href="#icon-moon"></use>
              </svg>
            </button>
            <div class="theme-menu" hidden>
              <button type="button" data-theme-value="light">
                <svg aria-hidden="true">
                  <use href="#icon-sun"></use>
                </svg>
                Light
              </button>
              <button type="button" data-theme-value="dark">
                <svg aria-hidden="true">
                  <use href="#icon-moon"></use>
                </svg>
                Dark
              </button>
              <button class="is-selected" type="button" data-theme-value="auto">
                <svg aria-hidden="true">
                  <use href="#icon-monitor"></use>
                </svg>
                Automatic
              </button>
            </div>
          </div>
        </div>
      </div>
    </header>

    <div class="search-overlay" hidden>
      <div
        class="search-dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="search-title"
      >
        <button
          class="search-close icon-button"
          type="button"
          aria-label="Close search"
        >
          <svg aria-hidden="true">
            <use href="#icon-close"></use>
          </svg>
        </button>
        <h2 id="search-title">Search</h2>
        <label for="site-search-input">Search publications and sections</label>
        <input
          id="site-search-input"
          type="search"
          placeholder="Search..."
          autocomplete="off"
        >
        <div class="search-results" aria-live="polite"></div>
      </div>
    </div>

    <main id="main">
      {{ content }}
    </main>

    <footer class="site-footer">
      <div class="page-shell footer-inner">
        <p>© {{ site.time | date: '%Y' }} Deokhyun Ahn</p>
        <p>Reliable video intelligence for social good.</p>
      </div>
    </footer>
  </body>
</html>
